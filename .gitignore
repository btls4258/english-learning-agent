# Virtual environments
# IMPORTANT: Never upload hundreds of MB of dependencies!
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ==========================
# Environment & Security (CRITICAL)
# ==========================
# NEVER upload files containing secrets!
.env
.env.*
*.env
api_keys.txt
secrets.json

# Keep example files
!.env.example
!secrets.example.json

